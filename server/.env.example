# EcoVoltX server configuration
# Copy to server/.env for local development. On a host (Railway, Render,
# Docker), set the same names as environment variables instead.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# ── Required in production ─────────────────────────────
NODE_ENV=development
PORT=3000
JWT_SECRET=
JWT_REFRESH_SECRET=

# Off in production by default. On = sample societies, demo logins
# (password "password123") and the charger simulator.
DEMO_MODE=

# First super admin, created on a fresh database when DEMO_MODE is off
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Platform Admin

# ── Optional ───────────────────────────────────────────
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
# Your public address(es), comma separated, e.g. https://ecovoltx.example.com
CORS_ORIGIN=http://localhost:5173
# SQLite file, relative to server/ or absolute (use a persistent volume)
DB_PATH=./data/societycharge.db
# Simulated charging sessions; defaults to DEMO_MODE
CHARGER_SIMULATOR=
# API requests allowed per client address per 15 minutes (sign-in has its own stricter limit)
API_RATE_LIMIT=1000

# ── Payments (Razorpay) ────────────────────────────────
# mock (default without keys), test or live
PAYMENT_MODE=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Required for webhooks: https://<your-domain>/api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=
